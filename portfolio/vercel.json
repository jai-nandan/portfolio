{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/contact.py": {
      "runtime": "python3.12"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
